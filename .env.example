# Copy to .env and fill in. docker compose reads this file directly.

# ---------------------------------------------------------------- naming
SERVER_NAME=timelines_server
DB_NAME=timelines_db

# ---------------------------------------------------------------- django
DEBUG=false
# Space-separated list of origins that may POST to this app.
URL=http://localhost:8000
HTTPS_ENABLED=false
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost 127.0.0.1 [::1]
TZ=UTC
LOG_LEVEL=INFO

# Port published on the host; INTERNAL_PORT is what the app binds inside.
OUTBOUND_PORT=8000
INTERNAL_PORT=8000

# Set these to have a superuser created on first start. Remove them once you
# have logged in -- setup_users skips accounts that already exist.
#ADMIN_EMAIL=
#ADMIN_PASSWORD=

# ---------------------------------------------------------------- database
# Leave SQL_HOST unset to keep everything in one SQLite file (SQLITE_PATH,
# /usr/src/app/data/db.sqlite3 in the container). To use PostgreSQL instead,
# uncomment these and start with: docker compose --profile postgres up -d
#SQL_DATABASE=timelines
#SQL_USER=timelines
#SQL_PASSWORD=
#SQL_HOST=${DB_NAME}
#SQL_PORT=5432

# ---------------------------------------------------------------- gunicorn
WEB_CONCURRENCY=4
GUNICORN_THREADS=1

# ---------------------------------------------------------------- frontend
# Dev only: serves assets from Vite instead of the built manifest.
DJANGO_VITE_DEV_MODE=true
DJANGO_VITE_DEV_SERVER_HOST=node
DJANGO_VITE_DEV_SERVER_PORT=5173
VITE_OUTBOUND_PORT=5173

# ---------------------------------------------------------------- sso
# All three must be set for the provider to be registered.
#OIDC_CLIENT_NAME=
#OIDC_CLIENT_ID=
#OIDC_CLIENT_SECRET=
#OIDC_SERVER_URL=
#OIDC_ALLOW_SIGNUP=true

# ---------------------------------------------------------------- api
# How often (seconds) a token's last_used_at is rewritten.
#API_TOKEN_LAST_USED_UPDATE_INTERVAL=600

